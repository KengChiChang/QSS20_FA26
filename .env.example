# Template for your API keys (lecture 8).
# 1. Copy this file to .env in the same folder:  cp .env.example .env
# 2. In .env, replace each placeholder with your own key.
# Git ignores .env, so your keys stay on your computer. Do not put a real key
# in this file: .env.example is tracked by Git and shared with the class.
FRED_API_KEY=your-key-here
